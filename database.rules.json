{
  "rules": {
    "profiles": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "displayName": { ".validate": "newData.isString() && newData.val().length <= 60" },
        "roleRequest": { ".validate": "newData.val() === 'member'" },
        "$other": { ".validate": false }
      }
    },
    "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } },
    "teachers": { "$uid": { ".read": "auth != null && auth.uid === $uid", ".write": false } },
    "messages": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && ((!data.exists() && (root.child('admins').child(auth.uid).val() === true || root.child('teachers').child(auth.uid).val() === true)) || (!newData.exists() && root.child('admins').child(auth.uid).val() === true))",
        ".validate": "newData.hasChildren(['authorUid','authorName','text','type','createdAt'])",
        "authorUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "authorName": { ".validate": "newData.isString() && newData.val().length <= 120" },
        "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 3000" },
        "type": { ".validate": "newData.val() === 'announcement' || (newData.val() === 'link' && root.child('admins').child(auth.uid).val() === true)" },
        "url": { ".validate": "!newData.exists() || (root.child('admins').child(auth.uid).val() === true && newData.isString() && newData.val().matches(/^https?:\\/\\/.+/))" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    }
  }
}
